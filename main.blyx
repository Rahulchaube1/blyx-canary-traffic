use std::cli;
use std::text;
use vendor::canary_traffic::canary_traffic;

fn main() {
    let arguments = cli_args();
    if args_len(arguments) > 0 {
        if args_len(arguments) % 2 != 0 {
            stderr_line("Expected event and value pairs");
            process_exit(2);
        }
        let mut live = canary_traffic_start();
        let mut i = 0;
        while i < args_len(arguments) {
            let input = args_at(arguments, i + 1);
            if !text_is_number(input) {
                stderr_line("Expected a whole numeric event value");
                process_exit(2);
            }
            live = canary_traffic_step(live, args_at(arguments, i), text_number(input));
            let command = canary_traffic_command(live);
            println!(command);
            if command == "reject" { process_exit(1); }
            i += 2;
        }
        return;
    }
    let mut state = canary_traffic_start();
    state = canary_traffic_step(state, "launch", 5.0);
    println!(canary_traffic_command(state));
    state = canary_traffic_step(state, "healthy", 5.0);
    println!(canary_traffic_command(state));
    state = canary_traffic_step(state, "ramp", 100.0);
    println!(canary_traffic_command(state));
    state = canary_traffic_step(state, "finish", 0.0);
    println!(canary_traffic_command(state));
    state = canary_traffic_step(state, "healthy", 100.0);
    println!(canary_traffic_command(state));
    state = canary_traffic_step(state, "finish", 0.0);
    println!(canary_traffic_command(state));
}
