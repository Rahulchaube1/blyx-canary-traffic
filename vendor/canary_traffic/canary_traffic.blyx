// Gate ordered traffic increases on the health of the current rollout percentage.
use std::cli;

pub fn canary_traffic_start() -> vector { [0, 0, 0] }

pub fn canary_traffic_step(snapshot: vector, event: str, value: f64) -> vector {
    if len(snapshot) != 3 { return []; }
    let phase = at(snapshot, 0);
    let saved = at(snapshot, 1);
    let previous = at(snapshot, 2);
    if !(phase >= 0.0 && phase < 5.0 && phase % 1.0 == 0.0 && previous >= 0.0 && previous < 5.0 && previous % 1.0 == 0.0 && saved >= 0.0 && saved <= 9007199254740991.0 && saved % 1.0 == 0.0) { return []; }
    if !(value >= 0.0 && value <= 1000000000.0 && value % 1.0 == 0.0) { return [phase, saved, 0]; }
    // idle
    if phase == 0.0 {
        if event == "launch" && value>0.0 && value<=100.0 {
            return [1, value, 1]; // apply_weight
        }
    }
    // probing
    if phase == 1.0 {
        if event == "healthy" && value==saved {
            return [2, saved, 2]; // authorize_ramp
        }
        if event == "unhealthy" {
            return [3, 0.0, 3]; // route_baseline
        }
    }
    // ready
    if phase == 2.0 {
        if event == "ramp" && value>saved && value<=100.0 {
            return [1, value, 1]; // apply_weight
        }
        if event == "finish" && saved==100.0 {
            return [4, saved, 4]; // retire_baseline
        }
    }
    [phase, saved, 0]
}

pub fn canary_traffic_command(snapshot: vector) -> str {
    if len(snapshot) != 3 { return "invalid"; }
    let action = at(snapshot, 2);
    if action == 0.0 { return "reject"; }
    if action == 1.0 { return "apply_weight"; }
    if action == 2.0 { return "authorize_ramp"; }
    if action == 3.0 { return "route_baseline"; }
    if action == 4.0 { return "retire_baseline"; }
    "invalid"
}

// Stop at the first rejected event. No host effects run during replay.
pub fn canary_traffic_replay(events: arglist, values: vector) -> vector {
    if args_len(events) != len(values) { return []; }
    let mut state = canary_traffic_start();
    let mut i = 0;
    while i < len(values) {
        state = canary_traffic_step(state, args_at(events, i), at(values, i));
        if at(state, 2) == 0.0 { return []; }
        i += 1;
    }
    state
}
